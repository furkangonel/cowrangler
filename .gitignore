# ==========================================
# Co-Wrangler - .gitignore
# ==========================================

# 0. Internal planning docs (not committed)
REFACTOR_PLAN.md
/docs/

# 1. Dependencies
node_modules/

# 2. Compilation output
dist/
build/
*.tsbuildinfo

# 3. Secrets & API keys — never commit
.env
.env.*
*.local
credentials.env
.npmrc

CLAUDE.md
PROGRESS.md

# 4. Co-Wrangler runtime files
# These are machine-local and session-specific.
# .cowrangler/skills/ is intentionally NOT ignored — project skills
# are worth tracking so the whole team benefits from them.
# .cowrangler/agents/ is intentionally NOT ignored — custom agent definitions are worth tracking.
.cowrangler/*
!.cowrangler/agents
!.cowrangler/agents/**
!.cowrangler/skills
!.cowrangler/skills/**

# SQLite databases (sessions, kanban, cron) — never commit
*.db
*.db-shm
*.db-wal

# REPL history (may contain sensitive prompts)
.cowrangler_history
*.repl_history

# Audit log (can contain user prompt data)
audit.log

# 5. OS & editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# 6. Logs
*.log
npm-debug.log*
yarn-error.log*

# 7. Other package manager lock files
# package-lock.json is intentionally tracked (CLI app — reproducible installs matter).
yarn.lock
pnpm-lock.yaml

# 8. Test / coverage output
coverage/
.nyc_output/

# 9. macOS extended attributes
.AppleDouble
.LSOverride

# 10. Trajectories (can contain full session transcripts)
trajectories/
*.trajectory.json

# 2b. Desktop build & packaging output — NEVER commit (huge binaries; CI rebuilds them)
out/
release/
*.dmg
*.zip
*.AppImage
*.exe
*.blockmap
*.snap
*.deb
*.rpm

# 11. electron-vite auto-generated temp config dumps — it recompiles
# electron.vite.config.ts to a timestamped .mjs/.cjs at boot; these are pure
# build output and regenerate every run. Root-anchored so the real
# electron.vite.config.ts (tracked) is never matched.
/electron.vite.config.*.mjs
/electron.vite.config.*.cjs

# 12. Ad-hoc scratch/debug scripts left at repo root (e.g. one-off `__t.mjs`
# repro scripts) and stray temp tsconfigs used for isolated typecheck runs.
/__t*.mjs
/__t*.cjs
tsconfig.*.tmp.json
