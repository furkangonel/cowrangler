{
  "name": "co-wrangler",
  "version": "2.0.3",
  "description": "An enterprise-grade personal AI agent for the terminal — powered by Claude, GPT, Gemini & more",
  "author": "Furkan Gönel <frkngnl000@gmail.com>",
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "cowrangler": "./dist/main.js"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--loader ts-node/esm --no-warnings' ts-node src/main.ts",
    "build": "tsc && npm run copy-assets && chmod +x dist/main.js",
    "copy-assets": "mkdir -p dist/bundled_skills && cp -rf src/bundled_skills/* dist/bundled_skills/ && mkdir -p dist/i18n/messages && cp src/i18n/messages/*.json dist/i18n/messages/ && mkdir -p dist/kanban && cp src/kanban/board.html dist/kanban/board.html && mkdir -p dist/assets && cp assets/kanban_ui_icon.png dist/assets/",
    "start": "node dist/main.js",
    "setup": "npm install && npm run build && npm link",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:preview": "electron-vite preview",
    "desktop:pack": "npm run desktop:build && electron-builder",
    "desktop:rebuild": "electron-rebuild -f -w better-sqlite3",
    "desktop:release": "bash scripts/release-desktop.sh"
  },
  "build": {
    "appId": "co.cowrangler.desktop",
    "productName": "Cowrangler",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/bundled_skills",
        "to": "bundled_skills"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "furkangonel",
        "repo": "cowrangler"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "claude",
    "gpt",
    "gemini",
    "terminal",
    "automation",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/google-vertex": "^1.0.4",
    "@ai-sdk/openai": "^1.0.0",
    "@clack/prompts": "^0.7.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.14",
    "ai": "^4.0.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.10.0",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "cli-table3": "^0.6.5",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.9.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.8.0",
    "markdown-pdf": "^11.0.0",
    "marked": "^12.0.0",
    "marked-terminal": "^7.0.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "ora": "^8.0.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "turndown": "^7.1.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/marked-terminal": "^6.1.0",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.4",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/furkangonel/cowrangler.git"
  }
}
