{
  "name": "co-wrangler",
  "version": "2.1.4",
  "description": "An enterprise-grade personal AI agent for the terminal — powered by Claude, GPT, Gemini & more",
  "author": "Furkan Gönel <frkngnl000@gmail.com>",
  "type": "module",
  "main": "apps/desktop/out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cowrangler/cli",
    "build": "tsc -b && npm run build -w @cowrangler/core && npm run build -w @cowrangler/cli",
    "start": "npm run start -w @cowrangler/cli",
    "setup": "npm install && npm run build && npm link --workspace apps/cli",
    "clean": "rm -rf packages/core/dist packages/adapters/*/dist apps/cli/dist apps/desktop/dist apps/desktop/out",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node scripts/check-any-budget.mjs",
    "lint:biome": "biome lint . --max-diagnostics=none",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/microbench/run.mjs",
    "test:coverage": "vitest run --coverage",
    "desktop:dev": "npm run dev -w @cowrangler/desktop",
    "desktop:build": "npm run build && npm run build -w @cowrangler/desktop",
    "desktop:preview": "npm run preview -w @cowrangler/desktop",
    "desktop:pack": "npm run desktop:build && electron-builder",
    "desktop:rebuild": "electron-rebuild -f -w better-sqlite3,node-pty && chmod +x node_modules/node-pty/build/Release/spawn-helper 2>/dev/null || true && chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "desktop:release": "bash scripts/release-desktop.sh",
    "pretest:e2e": "npm run desktop:build",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "build": {
    "appId": "co.cowrangler.desktop",
    "productName": "Cowrangler",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "apps/desktop/out/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundled_skills",
        "to": "bundled_skills"
      },
      {
        "from": "packages/core/src/cowrangler-sandbox.bundle",
        "to": "cowrangler-sandbox.bundle"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "furkangonel",
        "repo": "cowrangler",
        "releaseType": "release"
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": {
        "teamId": "VRH6M7YQT6"
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "claude",
    "gpt",
    "gemini",
    "terminal",
    "automation",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.11",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/google-vertex": "^5.0.15",
    "@ai-sdk/openai": "^4.0.11",
    "@clack/prompts": "^1.7.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node-cron": "^3.0.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.20",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "cli-table3": "^0.6.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "esbuild-wasm": "^0.28.1",
    "exceljs": "^4.4.0",
    "fast-glob": "^3.3.3",
    "fix-path": "^5.0.0",
    "highlight.js": "^11.9.0",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "js-yaml": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.8.0",
    "marked": "^18.0.6",
    "marked-terminal": "^7.0.0",
    "node-cron": "^4.6.0",
    "node-pty": "^1.0.0",
    "ora": "^9.4.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "turndown": "^7.1.3",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.23.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/marked-terminal": "^6.1.0",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.4",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/furkangonel/cowrangler.git"
  }
}
