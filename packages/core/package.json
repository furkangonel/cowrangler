{
  "name": "@cowrangler/core",
  "version": "2.1.6",
  "private": true,
  "description": "Cowrangler çekirdeği — SDK-agnostik model/provider katmanı, ajan loop, context scoping. Hiçbir arayüze bağımlı değildir.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./model": "./dist/model/native/index.js",
    "./context": "./dist/context_scopes.js",
    "./*.js": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -b && npm run copy-assets",
    "copy-assets": "node copy-assets.js"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  }
}
